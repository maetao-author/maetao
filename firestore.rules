rules_version = '2';
// Security rules for the Mae Tao community board.
// 1. Replace YOUR-EMAIL@gmail.com below with the Google account you sign in with (lowercase).
// 2. Firebase console → Firestore Database → Rules → paste this whole file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner() { return 'your-email@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isMae() {
      // .get() so anonymous readers (who have no email) simply aren't Mae instead of causing an error
      return signedIn() && request.auth.token.get('email', '') is string
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == owner();
    }
    function prof() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function text(t, max) { return t is string && t.size() > 0 && t.size() <= max; }
    function reserved(h) { return h in ['mae', 'maetao', 'mae_tao', 'mae.tao', 'admin', 'official', 'moderator']; }
    // a GIPHY GIF or sticker id (optional on posts, replies and chat)
    function gifOk(v) { return v is string && v.matches('^[A-Za-z0-9]{4,40}$'); }
    function okGif(d) { return (!('gif' in d) || gifOk(d.gif)) && (!('sticker' in d) || gifOk(d.sticker)); }
    // a shared song card in the chat (an iTunes preview)
    function okSong(d) {
      return !('song' in d) || (d.song is map && d.song.keys().hasOnly(['id', 't', 'a', 'art', 'p', 'y'])
        && (!('y' in d.song) || (d.song.y is string && d.song.y.matches('^[A-Za-z0-9_-]{11}$')))
        && d.song.id is string && d.song.id.matches('^[0-9]{1,15}$')
        && d.song.t is string && d.song.t.size() <= 120 && d.song.a is string && d.song.a.size() <= 120
        && d.song.art is string && d.song.art.matches('^https://is[0-9]-ssl[.]mzstatic[.]com/.{1,400}$')
        && d.song.p is string && d.song.p.matches('^https://audio-ssl[.]itunes[.]apple[.]com/.{1,500}$'));
    }
    // a photo id must point at a photo the same person is saving in the same write
    function okPhoto(d) {
      return !('photo' in d) || (d.photo is string && d.photo.matches('^[A-Za-z0-9]{6,40}$')
        && getAfter(/databases/$(database)/documents/photos/$(d.photo)).data.uid == request.auth.uid);
    }
    // a post needs words, a GIF or a photo
    function okBody(d) { return d.text is string && d.text.size() <= 1000 && (d.text.size() > 0 || 'gif' in d || 'sticker' in d || 'photo' in d || 'song' in d) && okGif(d) && okPhoto(d) && okSong(d); }
    function asMe(d) {
      return d.uid == request.auth.uid && d.handle == prof().handle && d.emoji == prof().emoji && d.color == prof().color
        && d.isMae == isMae() && d.createdAt == request.time;
    }
    // emoji reactions live in reacts.{uid} = [emoji, …]; you can only change your own list
    function reactOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacts'])
        && request.resource.data.reacts is map
        && request.resource.data.reacts.diff(resource.data.get('reacts', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.reacts.get(request.auth.uid, []) is list
        && request.resource.data.reacts.get(request.auth.uid, []).size() <= 20;
    }
    function okHandle(h) { return h is string && h.matches('^[a-z0-9_.]{3,20}$') && (!reserved(h) || isMae()); }

    // reader profiles: @handle, character ("c:01"–"c:60") or emoji, colour
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['handle', 'emoji', 'color'])
        && okHandle(request.resource.data.handle)
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
    }

    // one owner per @handle
    match /handles/{h} {
      allow read: if true;
      allow create: if signedIn() && okHandle(h)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'emoji', 'color', 'type', 'text', 'gif', 'sticker', 'photo', 'hearts', 'replyCount', 'status', 'pinned', 'isMae', 'maeReplied', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == prof().handle
        && request.resource.data.emoji == prof().emoji
        && request.resource.data.color == prof().color
        && request.resource.data.type in ['chat', 'ask', 'idea']
        && okBody(request.resource.data)
        && request.resource.data.hearts.size() == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.status == ''
        && request.resource.data.pinned == false
        && request.resource.data.maeReplied == false
        && request.resource.data.isMae == isMae()
        && request.resource.data.createdAt == request.time;

      allow update: if isMae()
        // anyone signed in can add or remove their own emoji reactions
        || reactOnly()
        // anyone signed in can add or remove only their own heart / vote
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
            && request.resource.data.hearts.toSet().difference(resource.data.hearts.toSet()).hasOnly([request.auth.uid])
            && resource.data.hearts.toSet().difference(request.resource.data.hearts.toSet()).hasOnly([request.auth.uid]))
        // replying bumps the reply count by exactly one
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
            && request.resource.data.replyCount == resource.data.replyCount + 1);

      allow delete: if isMae() || (signedIn() && resource.data.uid == request.auth.uid);

      match /replies/{rid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'handle', 'emoji', 'color', 'text', 'gif', 'sticker', 'photo', 'parent', 'isMae', 'createdAt'])
          && (!('parent' in request.resource.data) || (request.resource.data.parent is string && request.resource.data.parent.matches('^[A-Za-z0-9]{1,40}$')))
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.handle == prof().handle
          && request.resource.data.emoji == prof().emoji
          && request.resource.data.color == prof().color
          && okBody(request.resource.data)
          && request.resource.data.isMae == isMae()
          && request.resource.data.createdAt == request.time;
        allow update: if isMae() || reactOnly();
        allow delete: if isMae() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // the live chat room
    match /chat/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'emoji', 'color', 'text', 'gif', 'sticker', 'photo', 'song', 'isMae', 'createdAt'])
        && asMe(request.resource.data)
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && okBody(request.resource.data);
      allow update: if isMae() || reactOnly();
      allow delete: if isMae() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // "who's here now" in the chat room: each reader writes only their own heartbeat
    match /presence/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['handle', 'emoji', 'color', 'at'])
        && request.resource.data.handle == prof().handle && request.resource.data.emoji == prof().emoji
        && request.resource.data.color == prof().color && request.resource.data.at == request.time;
    }

    // each reader's bookshelf (the books they own). Only they (and Mae) can see it.
    // A store webhook can add purchases with the Admin SDK, which skips these rules.
    match /libraries/{uid} {
      allow read: if isMae() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['books', 'updatedAt'])
        && request.resource.data.books is list && request.resource.data.books.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }

    // photos readers attach to posts, replies and chat messages (small JPEGs, under about 700 KB)
    match /photos/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'data', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 750000
        && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.createdAt == request.time;
      allow delete: if isMae() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // private: only Mae can read these
    match /signings/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['book', 'format', 'signTo', 'message', 'email', 'createdAt'])
        && text(request.resource.data.signTo, 80) && text(request.resource.data.email, 120)
        && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isMae();
    }
    match /arc/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'email', 'profile', 'why', 'where', 'createdAt'])
        && text(request.resource.data.name, 80) && text(request.resource.data.email, 120)
        && request.resource.data.why.size() <= 800 && request.resource.data.profile.size() <= 200
        && request.resource.data.where.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isMae();
    }
  }
}
