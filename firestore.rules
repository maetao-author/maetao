rules_version = '2';
// Security rules for the Mae Tao community board.
// 1. Replace YOUR-EMAIL@gmail.com below with the Google account you sign in with (lowercase).
// 2. Firebase console → Firestore Database → Rules → paste this whole file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner() { return 'your-email@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function isMae() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == owner();
    }
    function prof() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function text(t, max) { return t is string && t.size() > 0 && t.size() <= max; }
    function reserved(h) { return h in ['mae', 'maetao', 'mae_tao', 'mae.tao', 'admin', 'official', 'moderator']; }
    function okHandle(h) { return h is string && h.matches('^[a-z0-9_.]{3,20}$') && (!reserved(h) || isMae()); }

    // reader profiles: @handle, emoji, colour
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['handle', 'emoji', 'color'])
        && okHandle(request.resource.data.handle)
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8
        && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
    }

    // one owner per @handle
    match /handles/{h} {
      allow read: if true;
      allow create: if signedIn() && okHandle(h)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'emoji', 'color', 'type', 'text', 'hearts', 'replyCount', 'status', 'pinned', 'isMae', 'maeReplied', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == prof().handle
        && request.resource.data.emoji == prof().emoji
        && request.resource.data.color == prof().color
        && request.resource.data.type in ['chat', 'ask', 'idea']
        && text(request.resource.data.text, 1000)
        && request.resource.data.hearts.size() == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.status == ''
        && request.resource.data.pinned == false
        && request.resource.data.maeReplied == false
        && request.resource.data.isMae == isMae()
        && request.resource.data.createdAt == request.time;

      allow update: if isMae()
        // anyone signed in can add or remove only their own heart / vote
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
            && request.resource.data.hearts.toSet().difference(resource.data.hearts.toSet()).hasOnly([request.auth.uid])
            && resource.data.hearts.toSet().difference(request.resource.data.hearts.toSet()).hasOnly([request.auth.uid]))
        // replying bumps the reply count by exactly one
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
            && request.resource.data.replyCount == resource.data.replyCount + 1);

      allow delete: if isMae() || (signedIn() && resource.data.uid == request.auth.uid);

      match /replies/{rid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'handle', 'emoji', 'color', 'text', 'isMae', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.handle == prof().handle
          && request.resource.data.emoji == prof().emoji
          && request.resource.data.color == prof().color
          && text(request.resource.data.text, 1000)
          && request.resource.data.isMae == isMae()
          && request.resource.data.createdAt == request.time;
        allow delete: if isMae() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // private: only Mae can read these
    match /signings/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['book', 'format', 'signTo', 'message', 'email', 'createdAt'])
        && text(request.resource.data.signTo, 80) && text(request.resource.data.email, 120)
        && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isMae();
    }
    match /arc/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'email', 'profile', 'why', 'where', 'createdAt'])
        && text(request.resource.data.name, 80) && text(request.resource.data.email, 120)
        && request.resource.data.why.size() <= 800 && request.resource.data.profile.size() <= 200
        && request.resource.data.where.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isMae();
    }
  }
}
